# /etc/systemd/system/wyd-qna.service
# 설치: sudo cp deploy/wyd-qna.service /etc/systemd/system/ && sudo systemctl daemon-reload && sudo systemctl enable --now wyd-qna
[Unit]
Description=WYD Seoul 2027 Q&A server
After=network.target

[Service]
Type=simple
User=wyd
WorkingDirectory=/srv/wyd-qna
EnvironmentFile=/srv/wyd-qna/.env
ExecStart=/usr/bin/node server/index.js
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
